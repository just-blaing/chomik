<local:drag_window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:chomik"
        x:Class="chomik.MessageBox"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
    <Border CornerRadius="12" Background="Black" BorderBrush="#9400d3" BorderThickness="2" MinWidth="240" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,16">
                <TextBlock x:Name="msg_text" Foreground="White" FontSize="13" TextWrapping="Wrap"
                           MaxWidth="200" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <local:sprite_view x:Name="anim_view" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" Background="#282828" Height="40">
                <Button Content="ok" Classes="flat" Click="on_ok_click" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80"/>
            </Border>
        </Grid>
    </Border>
</local:drag_window>
