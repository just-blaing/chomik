<local:drag_window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:chomik"
        x:Class="chomik.AppSelector"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="300" Height="300">
    <Border CornerRadius="12" Background="Black" BorderBrush="#9400d3" BorderThickness="2" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock x:Name="title_text" Foreground="White" Margin="20" Grid.Row="0"/>
            <ListBox x:Name="app_list" Background="#1e1e1e" Foreground="White" Margin="20,0,20,20" Grid.Row="1"/>
            <Border Grid.Row="2" Background="#282828" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="select_btn" Classes="flat" Click="on_select_click"/>
                    <Button x:Name="cancel_btn" Classes="flat" Click="on_cancel_click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:drag_window>
